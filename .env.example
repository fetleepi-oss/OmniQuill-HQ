# =============================================================================
# QUILL — TEMPLATE ENVIRONMENT (Safe for public git repositories)
#
# ⚠️  NEVER commit real credentials to git!
#     Copy this file to `.env` (which is in .gitignore) and put your keys there.
# =============================================================================

# Gemini AI API Key (Injected by AI Studio or set locally)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# ---------------------------------------------------------------------------
# Paddle — server-side API key (used for cancel/restore subscription calls)
# ---------------------------------------------------------------------------
PADDLE_API_KEY="pdl_sdbx_apikey_REPLACE_WITH_YOUR_KEY"

# Client-side token — Paddle.js token
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN="test_REPLACE_WITH_YOUR_CLIENT_TOKEN"
PADDLE_CLIENT_TOKEN="test_REPLACE_WITH_YOUR_CLIENT_TOKEN"
NEXT_PUBLIC_PADDLE_ENV="sandbox"
PADDLE_ENV="sandbox"
PADDLE_PRODUCT_ID="pro_REPLACE_WITH_YOUR_PRODUCT_ID"

# Price IDs
PADDLE_PRICE_ID_PRO="pri_REPLACE_WITH_PRO_PRICE_ID"
NEXT_PUBLIC_PADDLE_PRICE_ID_PRO="pri_REPLACE_WITH_PRO_PRICE_ID"
PADDLE_PRICE_ID_STARTER="pri_REPLACE_WITH_STARTER_PRICE_ID"
NEXT_PUBLIC_PADDLE_PRICE_ID_STARTER="pri_REPLACE_WITH_STARTER_PRICE_ID"
PADDLE_PRICE_ID_BUSINESS="pri_REPLACE_WITH_BUSINESS_PRICE_ID"
NEXT_PUBLIC_PADDLE_PRICE_ID_BUSINESS="pri_REPLACE_WITH_BUSINESS_PRICE_ID"

# Webhook signing secret
PADDLE_WEBHOOK_SECRET="pdl_whsec_REPLACE_WITH_WEBHOOK_SECRET"

# ---------------------------------------------------------------------------
# Chapa — Ethiopian payments (Telebirr, CBE Birr, mobile money)
# ---------------------------------------------------------------------------
CHAPA_PUBLIC_KEY="CHAPUBK_TEST-REPLACE_WITH_PUBLIC_KEY"
CHAPA_SECRET_KEY="CHASECK_TEST-REPLACE_WITH_SECRET_KEY"
CHAPA_WEBHOOK_SECRET="chapa_whsec_REPLACE_WITH_WEBHOOK_SECRET"

CHAPA_PLAN_PRICE_STARTER_ETB="1600"
CHAPA_PLAN_PRICE_PRO_ETB="3800"
CHAPA_PLAN_PRICE_BUSINESS_ETB="7100"

# Set DEMO_MODE="true" only if you want offline mock fallback when testing without internet/credentials. Defaults to false.
DEMO_MODE="false"

# ---------------------------------------------------------------------------
# Database & Persistence (Vercel KV / Upstash Redis)
# Automatically injected when connecting Upstash Redis via Vercel Marketplace
# ---------------------------------------------------------------------------
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
# Or Upstash Redis direct alias:
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# App & Support Settings
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
SUPPORT_INBOX_EMAIL="support@yourdomain.com"
CRON_SECRET="change-to-a-random-secret-token"
